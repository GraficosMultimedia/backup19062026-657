<?php require __DIR__.'/app/core/bootstrap.php';$exists=(int)$pdo->query('SELECT COUNT(*) FROM usuarios')->fetchColumn();$msg='';if($_SERVER['REQUEST_METHOD']==='POST'&&$exists===0){check_csrf();$s=$pdo->prepare('INSERT INTO usuarios(nombre,email,password_hash,rol) VALUES(?,?,?,"admin")');$s->execute([$_POST['nombre'],$_POST['email'],password_hash($_POST['password'],PASSWORD_DEFAULT)]);$msg='Administrador creado. Elimine install.php y entre al sistema.';}?><!doctype html><html lang="es"><head><meta charset="utf-8"><title>Instalador</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><div class="container py-5" style="max-width:600px"><h1>Instalación</h1><?php if($exists):?><div class="alert alert-warning">Ya existe un usuario. Elimine install.php.</div><?php elseif($msg):?><div class="alert alert-success"><?=e($msg)?></div><?php else:?><form method="post"><input type="hidden" name="csrf" value="<?=csrf()?>"><input class="form-control mb-2" name="nombre" placeholder="Nombre" required><input class="form-control mb-2" name="email" type="email" placeholder="Correo" required><input class="form-control mb-3" name="password" type="password" minlength="8" placeholder="Contraseña" required><button class="btn btn-primary">Crear administrador</button></form><?php endif?></div></body></html>
